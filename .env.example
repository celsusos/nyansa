# Secret required by POST /bootstrap when NYANSA_PRODUCTION=true.
# Generate this yourself and store it in your secret manager.
# Example: openssl rand -base64 48
COMPOSE_BAKE=true
NYANSA_BOOTSTRAP_SECRET=replace-with-random-bootstrap-secret
NYANSA_TOKEN_PEPPER=replace-with-random-token-pepper
NYANSA_ATTESTATION_KEY_SEED=replace-with-random-attestation-key-seed

# Private Docker Compose Postgres.
# Generate POSTGRES_PASSWORD yourself and keep it out of source control.
POSTGRES_DB=nyansa
POSTGRES_USER=nyansa
POSTGRES_PASSWORD=replace-with-random-postgres-password
DATABASE_URL=postgresql://nyansa:replace-with-random-postgres-password@postgres:5432/nyansa

# Initial root UI password and recovery/CLI token.
# `nyansa-init` (or `make dev-setup`) generates these and writes them here.
# Users normally sign in with user/password, then issue their own CLI token in the UI.
NYANSA_ROOT_PASSWORD=replace-with-root-password
NYANSA_CONTROL_TOKEN=replace-with-root-recovery-or-cli-token

# OpenAI-compatible model endpoint used by the agent runtime.
# Default hosted fallback: https://openrouter.ai/api/v1
# Ollama local alternative: http://localhost:11434/v1
# Internal gateway example: https://llm-gateway.company.example/v1
BASE_URL=https://openrouter.ai/api/v1
# Free, tool-capable coding model (no per-token charge — you still need a free
# OpenRouter key below). Free models rotate and are rate-limited; if this id stops
# working, pick another from https://openrouter.ai/models?max_price=0 (e.g.
# poolside/laguna-xs-2.1:free, inclusionai/ling-3.0-flash:free), or use a paid
# model like openai/gpt-4o-mini for higher limits and reliability.
NYANSA_MODEL=poolside/laguna-s-2.1:free

# Model provider API key read by config.model.api_key_env.
# Ollama local dev can use "local" because no real key is required.
# OpenRouter: create a (free) key at https://openrouter.ai/settings/keys — required
# even for free models, which are rate-limited per account.
NYANSA_API_KEY=

# Microsoft Entra ID / Microsoft sign-in.
# Register a Web app in Microsoft Entra and add this redirect URI:
#   https://your-domain.example/auth/microsoft/callback
NYANSA_MICROSOFT_ENABLED=false
NYANSA_MICROSOFT_TENANT=organizations
NYANSA_MICROSOFT_CLIENT_ID=
NYANSA_MICROSOFT_CLIENT_SECRET=
NYANSA_MICROSOFT_REDIRECT_URI=https://your-domain.example/auth/microsoft/callback
NYANSA_MICROSOFT_ALLOWED_DOMAINS=your-domain.example
# Optional multi-org routing. Values may be organization IDs or exact org names.
NYANSA_MICROSOFT_DOMAIN_ORG_MAP=your-domain.example:Default Organization
NYANSA_MICROSOFT_AUTO_PROVISION=true
NYANSA_MICROSOFT_DEFAULT_ROLE=developer

# --- Production hardening (optional; sensible defaults shown) ---
# Public hostname for the Caddy TLS proxy (docker compose --profile tls up).
DOMAIN=localhost
# Per-IP requests/minute on the control-plane API (0 disables the limiter).
NYANSA_RATE_LIMIT_PER_MINUTE=120
# Default lifetime for issued member tokens, in hours (0 = never expire).
NYANSA_TOKEN_TTL_HOURS=720
