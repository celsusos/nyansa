{
  "name": "agent-ui",
  "version": "0.0.1",
  "description": "Quasar enterprise control plane for Nyansa",
  "productName": "Nyansa Control Plane",
  "author": "Kwaku Boateng <kwaku.oboateng@outlook.com>",
  "type": "module",
  "private": true,
  "scripts": {
    "lint": "oxfmt && oxlint --fix",
    "lint:check": "oxfmt --check && oxlint",
    "dev": "quasar dev --host 0.0.0.0",
    "build": "quasar build",
    "typecheck": "quasar prepare && vue-tsc --noEmit",
    "postinstall": "echo agent-ui ready"
  },
  "dependencies": {
    "@quasar/extras": "^2.0.2",
    "pinia": "^3.0.1",
    "quasar": "^2.23.1",
    "vue": "^3.5.22",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@quasar/app-vite": "^3.2.0",
    "@types/node": "24",
    "@vitejs/plugin-vue": "^6.0.8",
    "autoprefixer": "^10.4.27",
    "oxfmt": "^0.x",
    "oxlint": "^1.x",
    "oxlint-tsgolint": "^0.x",
    "typescript": "^7.0.2",
    "vite": "^8.1.0",
    "vue-tsc": "^3.3.3"
  },
  "keywords": [
    "quasar",
    "quasar-app",
    "quasar-cli",
    "quasar-app-vite",
    "vite",
    "vue",
    "vuejs"
  ],
  "engines": {
    "node": ">=22.22.0"
  }
}
